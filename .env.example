# ── 운용 모드 ─────────────────────────────────────────────
# dry_run: 주문을 만들기만 하고 보내지 않는다 (기본값)
# paper:   내부 모의 브로커로 체결을 시뮬레이션한다
# live:    토스증권 API로 실제 주문을 보낸다 (사람 승인 필수)
AUTOPILOT_MODE=dry_run

# ── DB (§4.3) ─────────────────────────────────────────────
# P1은 SQLite, 운영은 PostgreSQL (예: postgresql+psycopg://user:pass@host:5432/autopilot)
DB_URL=sqlite:///data/autopilot.db

# ── Claude API ────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── 데이터 원천 (§4.1) ────────────────────────────────────
# DART Open API 키 (https://opendart.fss.or.kr 에서 무료 발급)
DART_API_KEY=
# KRX 정보데이터시스템 회원 계정 — pykrx 1.2.9 이상은 로그인이 필요하다.
# 비워 두면 시세는 FinanceDataReader로 대체하고, 공매도·업종 데이터는 수집하지 못한다(신선도 플래그 기록).
KRX_ID=
KRX_PW=
# 네이버 검색 API (뉴스) — https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 한국은행 경제통계시스템(ECOS) API 키
ECOS_API_KEY=

# ── 토스증권 (실행 엔진, live 모드에서만 사용) ──────────────
TOSS_APP_KEY=
TOSS_APP_SECRET=
TOSS_ACCOUNT_NO=
TOSS_BASE_URL=

# ── 스케줄러 ──────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
